<UserControl x:Class="OCRRoo_Frontend.ExtractionTextWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OCRRoo_Frontend"
             mc:Ignorable="d"
             d:DesignHeight="800"
        d:DesignWidth="1330">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colour Scheme -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#b395b9"/>
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#FFE4F2"/>

        <!-- Heading -->
        <Label Grid.Row="0"
                Grid.ColumnSpan="2"
                Content="Extraction Information"
                HorizontalAlignment="Center"
                Height="80"
                VerticalAlignment="Center"
                Width="800"
                FontSize="40"
                FontWeight="Bold"
                HorizontalContentAlignment="Center"/>

        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="NoExtractions"
                        Text="No Extractions Yet"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Margin="0, 50"/>

                <ItemsControl x:Name="ExtractionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#b395b9"
                                    BorderThickness="0, 0, 0, 2"
                                    Padding="30, 20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                            Grid.Row="0">
                                        <TextBlock Text="Extraction File:"
                                                FontSize="20"
                                                FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Location}"
                                                FontSize="20"
                                                Margin="0, 0, 0, 10"/>

                                        <TextBlock Text="Extraction Time:"
                                                FontSize="20"
                                                FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Timing}"
                                                FontSize="20"
                                                Margin="0, 0, 0, 10"/>

                                        <TextBlock Text="Extraction Text:"
                                                FontSize="20"
                                                FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Text, Mode=OneWay}"
                                                   FontSize="20"
                                                Margin="0, 0, 0, 10"
                                                   AutomationProperties.Name="Extracted Text"/>
                                    </StackPanel>

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Background="#854b8f"
                                            Foreground="White"
                                            Content="DELETE"
                                            Width="200"
                                            Height="40"
                                            VerticalAlignment="Top"
                                            TextBlock.FontSize="20"
                                            TextBlock.FontWeight="Bold"
                                            Click="DeleteButton_Click"/>

                                    <Button Grid.Row="1"
                                            Grid.Column="0"
                                            Background="#854b8f"
                                            Foreground="White"
                                            Content="COPY"
                                            Margin="0,15,0,0"
                                            HorizontalAlignment="Left"
                                            Width="120"
                                            Height="40"
                                            TextBlock.FontSize="20"
                                            TextBlock.FontWeight="Bold"
                                            Click="CopyButton_Click"/>

                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Background="#854b8f"
                                            Foreground="White"
                                            Content="DOWNLOAD .TXT"
                                            Margin="0,15,0,0"
                                            Width="200"
                                            Height="40"
                                            TextBlock.FontSize="20"
                                            TextBlock.FontWeight="Bold"
                                            Click="DownloadButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>

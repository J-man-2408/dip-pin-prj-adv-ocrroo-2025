<Window x:Class="OCROO_Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OCROO_Frontend"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1330">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colour Scheme -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#b395b9" />

        <!-- Header -->
        <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Welcome To OCROO" HorizontalAlignment="Center" Height="80" VerticalAlignment="Center" Width="800" FontSize="40" FontWeight="Bold" HorizontalContentAlignment="Center"/>

        <!-- Main Body -->
        <Image AutomationProperties.Name="Astonaut Boy Connected To Book Image" Source="/Images/hero-image.jpg" Grid.Row="1" Grid.RowSpan="2"  Grid.ColumnSpan="2" Stretch="Fill"/>
        <Label Grid.Row="2" Grid.Column="1" Content="Your Friendly Optical Character Recognition Software" HorizontalAlignment="Center" Height="80" VerticalAlignment="Top" Width="700" FontSize="25" FontWeight="Bold" HorizontalContentAlignment="Center" Background="#b395b9" VerticalContentAlignment="Center" Margin="0,190,0,0"/>
    </Grid>
</Window>

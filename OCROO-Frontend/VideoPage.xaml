<UserControl x:Class="OCROO_Frontend.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OCROO_Frontend"
        mc:Ignorable="d"
        d:DesignHeight="800" d:DesignWidth="1330">
    
    <Grid>
       <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="900"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colour Scheme -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#b395b9" />
        <Border Grid.Row="1" Grid.ColumnSpan="3" Grid.RowSpan="2" Background="#FFE4F2"/>

        <!-- Heading -->
        <Label Grid.Row="0" Grid.ColumnSpan="3" Content="Select A Video To Extract Text From" HorizontalAlignment="Center" Height="80" VerticalAlignment="Center" Width="800" FontSize="40" FontWeight="Bold" HorizontalContentAlignment="Center"/>

        <!-- Buttons -->
        <Button AutomationProperties.Name="Upload Video Not Implemented" 
                Background="#854b8f" Foreground="White" 
                Grid.Row="2" Grid.Column="0" 
                Content="UPLOAD" Margin="50, 100" 
                TextBlock.FontSize="20" 
                TextBlock.FontWeight="Bold"/>
        
        <Button x:Name ="ExtractButton" 
                Background="#854b8f" Foreground="White" 
                Grid.Row="2" Grid.Column="2" 
                Content="EXTRACT" Margin="50, 100" 
                TextBlock.FontSize="20" 
                TextBlock.FontWeight="Bold" 
                Click="ExtractButton_Click"/>

        <Button x:Name="PlayPauseButton"
                Grid.Row="2" Grid.Column="1"
                Background="#854b8f" Foreground="White"
                Content="PLAY"
                Width="200" Height="60"
                VerticalAlignment="Bottom" 
                Margin="0,0,0,10"
                TextBlock.FontSize="20" 
                TextBlock.FontWeight="Bold"
                Click="PlayPauseButton_Click"/>

        <!-- Video Player -->
        <MediaElement x:Name="VideoPlayer"
                      Grid.Row="1" Grid.Column="1" 
                      Grid.RowSpan="2"
                      Margin="0,50,0,100"
                      LoadedBehavior="Manual"
                      Stretch="Uniform"
                      ScrubbingEnabled="True"
                      AutomationProperties.Name="Video player screen"/>
    </Grid>
    
</UserControl>

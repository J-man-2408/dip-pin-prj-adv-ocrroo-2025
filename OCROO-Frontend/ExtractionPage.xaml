<UserControl x:Class="OCROO_Frontend.ExtractionTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OCROO_Frontend"
        mc:Ignorable="d"
        d:DesignHeight="800" d:DesignWidth="1330">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colour Scheme -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#b395b9" />
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFE4F2"/>
        
        <!-- Heading -->
        <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Extraction Information" HorizontalAlignment="Center" Height="80" VerticalAlignment="Center" Width="800" FontSize="40" FontWeight="Bold" HorizontalContentAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="NoExtractions" Text="No Extractions Yet" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0, 50"/>

                <ItemsControl x:Name="ExtractionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#b395b9" BorderThickness="0, 0, 0, 2" Padding="30, 20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                        <TextBlock Text="Extraction File:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Location}" FontSize="20" Margin="0, 0, 0, 10" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Extraction Time:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Timing}" FontSize="20" Margin="0, 0, 0, 10" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Extraction Text:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Text, Mode=OneWay}" 
                                                   FontSize="20" Margin="0, 0, 0, 10"
                                                   AutomationProperties.Name="Extracted Text" 
                                                   HorizontalAlignment="Center"/>

                                    <Button Background="#854b8f" Foreground="White" 
                                            Content="COPY" Margin="0, 15, 0, 0" 
                                            HorizontalAlignment="Left"
                                            Width=" 120" Height="40"
                                            TextBlock.FontSize="20" 
                                            TextBlock.FontWeight="Bold"
                                            Click="CopyButton_Click"/>       
                                </StackPanel>

                                <Button Background="#854b8f" Foreground="White" 
                                        Grid.Column="1" 
                                        Content="DELETE" 
                                        Click="DeleteButton_Click"
                                        Width="120" Height="40"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    
    </Grid>
</UserControl>
